# Google Gemini API Key (Get free key from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

BOT_NAME=FRIDAY

# High-fidelity authentic Irish female neural AI voice
FRIDAY_VOICE=en-IE-EmilyNeural

GEMINI_MODEL=gemini-2.0-flash
OLLAMA_MODEL=llama3
MEMORY_FILE=friday_memory.json

# Microphone Configuration:
# Leave blank to automatically use Windows default active microphone
MIC_INDEX=
# Base audio sensitivity threshold
MIC_THRESHOLD=35

# D-ID Talking Avatar (optional — get free key from https://www.d-id.com)
# Leave blank to use static frame lip-sync instead
DID_API_KEY=
# Public URL to your FRIDAY face image (host on imgur, S3, etc.)
FRIDAY_FACE_URL=
